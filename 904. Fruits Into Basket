//BruteForce Approach   ( T.C : O(N^2)  , S.C : O(3) )    Time limit exceeded


import java.util.Set;
import java.util.HashSet;

class Solution {
    public int totalFruit(int[] fruits) {
        int n = fruits.length;
        int maxlen = 0;

        for(int i = 0; i < n; i++) {
            Set<Integer> st = new HashSet<>();
            for(int j = i; j < n; j++) {
                st.add(fruits[j]);

                if(st.size() <= 2){
                    maxlen = Math.max(maxlen , j - i + 1);
                } else {
                    break;
                }
            }
        }
        return maxlen;
    }
}


//Better Approach        ( T.C : O(2N)  , S.C : O(3) )



class Solution {
    public int totalFruit(int[] fruits) {
        int n = fruits.length;
        int k = 2;
        int l = 0, r = 0;
        int maxlen = 0;

        HashMap<Integer,Integer> hs = new HashMap<>();

        while(r < n) {
            hs.put(fruits[r], hs.getOrDefault(fruits[r], 0) + 1);
            if(hs.size() > k) {
                while(hs.size() > k) {
                    hs.put(fruits[l], hs.get(fruits[l]) - 1);
                    if(hs.get(fruits[l]) == 0) hs.remove(fruits[l]);
                    l++;
                }
            }

            if(hs.size() <= k) {
                maxlen = Math.max(maxlen , r - l + 1);
            }
            r++;
        }

        
        return maxlen;
    }
}
