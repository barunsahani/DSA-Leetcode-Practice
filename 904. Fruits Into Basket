//BruteForce Approach   ( T.C : O(N^2)  , S.C : O(3) )    Time limit exceeded


import java.util.Set;
import java.util.HashSet;

class Solution {
    public int totalFruit(int[] fruits) {
        int n = fruits.length;
        int maxlen = 0;

        for(int i = 0; i < n; i++) {
            Set<Integer> st = new HashSet<>();
            for(int j = i; j < n; j++) {
                st.add(fruits[j]);

                if(st.size() <= 2){
                    maxlen = Math.max(maxlen , j - i + 1);
                } else {
                    break;
                }
            }
        }
        return maxlen;
    }
}
