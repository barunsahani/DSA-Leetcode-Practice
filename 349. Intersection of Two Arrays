class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {

        int[] temp = new int[Math.min(nums1.length, nums2.length)];
        int k = 0;

        // Traverse nums1
        for (int i = 0; i < nums1.length; i++) {

            // Check if nums1[i] exists in nums2
            boolean found = false;

            for (int j = 0; j < nums2.length; j++) {

                if (nums1[i] == nums2[j]) {
                    found = true;
                    break;
                }
            }

            // If found in nums2, check duplicate
            if (found) {

                boolean alreadyPresent = false;

                for (int j = 0; j < k; j++) {
                    if (temp[j] == nums1[i]) {
                        alreadyPresent = true;
                        break;
                    }
                }

                // Add only if not already present
                if (!alreadyPresent) {
                    temp[k] = nums1[i];
                    k++;
                }
            }
        }

        // Create exact-size answer
        int[] ans = new int[k];

        for (int i = 0; i < k; i++) {
            ans[i] = temp[i];
        }

        return ans;
    }
}
