//optimized 2 pointer 

class Solution {
    static ArrayList<Integer> intersection(int arr1[], int arr2[]) {

        int i = 0;
        int j = 0;

        ArrayList<Integer> inter = new ArrayList<>();

        while(i < arr1.length && j < arr2.length) {

            if(arr1[i] < arr2[j]) {
                i++;
            }
            else if(arr1[i] > arr2[j]) {
                j++;
            }
            else {
                if(inter.size() == 0 ||
                   inter.get(inter.size() - 1) != arr1[i]) {

                    inter.add(arr1[i]);
                }

                i++;
                j++;
            }
        }

        return inter;
    }
}
