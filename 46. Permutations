T.C : O(n! * n)
S.C : O(N) + O(N)


class Solution {
    public List<List<Integer>> permute(int[] nums) {
        List<List<Integer>> res = new ArrayList<>();
        List<Integer> ds = new ArrayList<>();
        boolean freq[] = new boolean[nums.length];
        findPermutation(nums, ds, res, freq);
        return res;

    }

    public  void findPermutation(int[] nums, List<Integer> ds, List<List<Integer>> res,boolean[] freq) {
        //base case
        if (ds.size() == nums.length ) {
            res.add(new ArrayList<>(ds));
            return;
            
        }
        //recursion
        for (int i = 0; i < nums.length ; i++) {
            if(!freq[i]) {
                freq[i] = true;
                ds.add(nums[i]);
                findPermutation( nums, ds, res, freq);

                ds.remove(ds.size() - 1);
                freq[i] = false;
            }
            
        }
    }
}
