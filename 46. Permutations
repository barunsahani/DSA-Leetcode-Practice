// Approach 1

T.C : O(n! * n)
S.C : O(N) + O(N)


class Solution {
    public List<List<Integer>> permute(int[] nums) {
        List<List<Integer>> res = new ArrayList<>();
        List<Integer> ds = new ArrayList<>();
        boolean freq[] = new boolean[nums.length];
        findPermutation(nums, ds, res, freq);
        return res;

    }

    public  void findPermutation(int[] nums, List<Integer> ds, List<List<Integer>> res,boolean[] freq) {
        //base case
        if (ds.size() == nums.length ) {
            res.add(new ArrayList<>(ds));
            return;
            
        }
        //recursion
        for (int i = 0; i < nums.length ; i++) {
            if(!freq[i]) {
                freq[i] = true;
                ds.add(nums[i]);
                findPermutation( nums, ds, res, freq);

                ds.remove(ds.size() - 1);
                freq[i] = false;
            }
            
        }
    }
}



// Approach 2 //swap used!

T.C : O(n! * n)
S.C : O(N) + O(N)

class Solution {
    public List<List<Integer>> permute(int[] nums) {
        List<List<Integer>> res = new ArrayList<>();
        findPermutation(0, nums, res);
        return res;

    }

    public  void findPermutation(int ind, int[] nums, List<List<Integer>> res) {
        //base case
        if (ind == nums.length ) {
            List<Integer> ds = new ArrayList<>();
            for(int i = 0; i < nums.length; i++) {
                ds.add(nums[i]);
            }
            res.add(new ArrayList<>(ds));
            return;
            
        }
        //recursion
        for (int i = ind; i < nums.length ; i++) {
            swap(i, ind, nums);
            findPermutation(ind+1, nums, res);
            swap(i, ind, nums);
        }
            
    }
    

    public void swap(int i, int j, int[] nums) {
        int temp = nums[i];
        nums[i] = nums[j];
        nums[j] = temp;
    }

}
