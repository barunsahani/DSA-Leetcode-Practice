class Solution {
    public int[] leftRightDifference(int[] nums) {
        int total = 0;
        int left = 0;
        for(int i = 0; i < nums.length; i++){
            total += nums[i];
        }

        int[] ans = new int[nums.length];
        for(int i = 0; i < nums.length; i++){
            int right = total - nums[i] - left;
            ans[i] = Math.abs(left - right);

            left += nums[i];
        }
        return ans;
    }
}
