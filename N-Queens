Time : O(n* n!)
Space: O(n² + k × n²)

import java.util.*;

class Solution {

    List<List<String>> ans = new ArrayList<>();

    // Check if placing a queen at (row, col) is safe
    public boolean isSafe(char[][] board, int row, int col) {

        // Vertical Up
        for (int i = row - 1; i >= 0; i--) {
            if (board[i][col] == 'Q') {
                return false;
            }
        }

        // Diagonal Left Up
        for (int i = row - 1, j = col - 1; i >= 0 && j >= 0; i--, j--) {
            if (board[i][j] == 'Q') {
                return false;
            }
        }

        // Diagonal Right Up
        for (int i = row - 1, j = col + 1; i >= 0 && j < board.length; i--, j++) {
            if (board[i][j] == 'Q') {
                return false;
            }
        }

        return true;
    }

    // Backtracking function
    public void nQueens(char[][] board, int row) {

        // Base Case
        if (row == board.length) {

            List<String> temp = new ArrayList<>();

            for (int i = 0; i < board.length; i++) {
                temp.add(new String(board[i]));
            }

            ans.add(temp);
            return;
        }

        // Try every column
        for (int j = 0; j < board.length; j++) {

            if (isSafe(board, row, j)) {

                board[row][j] = 'Q';       // Place Queen

                nQueens(board, row + 1);   // Recursive Call

                board[row][j] = '.';       // Backtracking
            }
        }
    }

    public List<List<String>> solveNQueens(int n) {

        char[][] board = new char[n][n];

        for (int i = 0; i < n; i++) {
            Arrays.fill(board[i], '.');
        }

        nQueens(board, 0);

        return ans;
    }
}



//Optimized Solution

Time Complexity: O(N!), we try all possible permutations of placing the queens.
Space Complexity: O(N), three boolean arrays are stored to check for safety.



import java.util.*;

class Solution {

    public List<List<String>> solveNQueens(int n) {

        List<List<String>> res = new ArrayList<>();

        char[][] board = new char[n][n];

        // Fill board with '.'
        for (int i = 0; i < n; i++) {
            Arrays.fill(board[i], '.');
        }

        int[] colCheck = new int[n];
        int[] upperDiagonal = new int[2 * n - 1];
        int[] lowerDiagonal = new int[2 * n - 1];

        // Start from row 0
        solve( 0, n, board, colCheck, upperDiagonal, lowerDiagonal, res);

        return res;
    }

    public void solve( int row, int n, char[][] board, int[] colCheck, int[] upperDiagonal, int[] lowerDiagonal, List<List<String>> res) {

        // Base case
        if (row == n) {

            List<String> temp = new ArrayList<>();

            for (int i = 0; i < n; i++) {
                temp.add(new String(board[i]));
            }

            res.add(temp);
            return;
        }

        // Try every column in current row
        for (int col = 0; col < n; col++) {

            // Check if position is safe
            if (colCheck[col] == 0 &&
                upperDiagonal[n - 1 + col - row] == 0 &&
                lowerDiagonal[row + col] == 0) {

                // Place queen
                board[row][col] = 'Q';

                colCheck[col] = 1;
                upperDiagonal[n - 1 + col - row] = 1;
                lowerDiagonal[row + col] = 1;

                // Move to next row
                solve( row + 1, n, board, colCheck, upperDiagonal, lowerDiagonal, res );

                // Backtrack
                board[row][col] = '.';

                colCheck[col] = 0;
                upperDiagonal[n - 1 + col - row] = 0;
                lowerDiagonal[row + col] = 0;
            }
        }
    }
}
