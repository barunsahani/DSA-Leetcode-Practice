class Solution {
    public boolean check(int[] nums) {
        int count = 0;
        int n = nums.length;
        for(int i = 1; i < n ; i++) {
            if(nums[i - 1] > nums[i]){
                count++;
            }
        }

        if(nums[n-1] > nums[0]) count++;

        if(count <= 1){
            return true;
        }
        return false;
    }
}


//ANother Method      [T.C : O(N) , S.C : O(1) ]

class Solution {
    public boolean check(int[] nums) {
        int n = nums.length;
        int count = 0;

        for(int i = 0; i < n; i++) {
            if(nums[i] > nums[(i+1) % n] ) {
                count++;
            }

            if (count > 1) {
                return false;
            }
            
        }

        return true;
    }
}
