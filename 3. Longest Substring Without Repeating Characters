        int n = s.length();

        int[] hash = new int[256];
        Arrays.fill(hash, -1);

        int maxlength = 0, l = 0, r = 0;

        while(r < n) {
           
            if(hash[s.charAt(r)] >= l ) {
                l = Math.max(hash[s.charAt(r)] + 1, l);
            }
            
            int len = r - l + 1;
                
            maxlength = Math.max(len , maxlength);
            hash[s.charAt(r)] = r;
            r++;
        }


        
            
           
