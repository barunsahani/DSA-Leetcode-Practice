//BruteForce Approach    "Time Limit Exceeded"

Main idea : For every substring, find the most frequent character and check whether the remaining characters can be replaced within k; if yes, update the maximum length.



class Solution {
    public int characterReplacement(String s, int k) {
        int n = s.length();
        int maxlen = 0;


        for(int i = 0; i < n; i++) {
            int[] freq = new int[26];
            int maxfq = 0;

            for(int j = i; j < n; j++) {
                freq[s.charAt(j) - 'A']++;
                maxfq = Math.max(maxfq , freq[s.charAt(j) - 'A']);
                int changes = (j - i + 1) - maxfq;

                if(changes <= k) maxlen = Math.max(maxlen, j - i + 1);
                else break;

            }
        }
        return maxlen;
    }
}




//Better Approach     (T.C : O(2N * 26) , S.C : O(26) )   

Main Idea : Keep expanding the window while the number of characters to replace (windowSize - maxFrequency) is at most k; otherwise shrink from the left.

class Solution {
    public int characterReplacement(String s, int k) {
        int n = s.length();
        int maxlen = 0;
        int maxfq = 0;
        int l = 0, r = 0;
        int[] freq = new int[26];


        while(r < n) {

            freq[s.charAt(r) - 'A']++;
            maxfq = Math.max(maxfq , freq[s.charAt(r) - 'A']);

            while((r-l+1) - maxfq > k) {
                freq[s.charAt(l) - 'A']--;
                l++;
            }
            
            maxlen = Math.max(maxlen, r - l + 1);
            r++;
        }
        return maxlen;
    }
}
