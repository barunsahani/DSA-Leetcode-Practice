class Solution {
    public static int largest(int[] arr) {
        // code here
        //method 1
        // (nlogn)
        // Arrays.sort(arr);
        // return arr[arr.length - 1];
        
        //method 2  (n)
        int largest = arr[0];
        int n = arr.length;
        for(int i = 1; i < n; i++) {
            if(arr[i] > largest) {
                largest = arr[i];
            }
        }
        return largest;
    }
}
