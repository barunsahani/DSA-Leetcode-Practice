//BruteForce Approach   (T.C : O(N^2) , S.C : O(1) )     "Time Limit Exceeded!!!!"

Main idea :  Generate every substring and count those whose frequency array shows at least one a, one b, and one c.

class Solution {
    public int numberOfSubstrings(String s) {
        int n = s.length();
        int count = 0;

        for(int i = 0; i < n; i++) {
            int[] freq = new int[3];
            for(int j = i; j < n; j++) {
                 freq[s.charAt(j) - 'a']++;
                if(freq[0] > 0 && freq[1] > 0 && freq[2] > 0) {
                    count++;
                }
            }
        }
        return count;
    }
}





//Optimized Solution     (T.C : O(N) , S.C : O(1) )


class Solution {
    public int numberOfSubstrings(String s) {
        int n = s.length();
        int count = 0;

            int[] freq = new int[3];
            Arrays.fill(freq,-1);

        for(int i = 0; i < n; i++) {
            
                freq[s.charAt(i) - 'a'] = i;
                if(freq[0] != -1 && freq[1] != -1 && freq[2] != -1) {
                    count = count + (1 + Math.min(freq[0] ,Math.min(freq[1] ,freq[2])));

                }
            
        }
        return count;
    }
}
