⭐ Key idea to remember
1. HashMap → count frequency
2. ArrayList → store unique elements
3. Sort → based on frequency
4. Take first k → answer

Time = O(n log n)
Space = O(n)


class Solution {
    public int[] topKFrequent(int[] nums, int k) {

        HashMap<Integer, Integer> hs = new HashMap<>();

        // Count frequency
        for (int num : nums) {
            hs.put(num, hs.getOrDefault(num, 0) + 1);
        }

        // Store all keys
        ArrayList<Integer> list = new ArrayList<>(hs.keySet());

        // Sort according to frequency
        list.sort((a, b) -> hs.get(b) - hs.get(a));

        // Take first k elements
        int[] ans = new int[k];

        for (int i = 0; i < k; i++) {
            ans[i] = list.get(i);
        }

        return ans;
    }
}
