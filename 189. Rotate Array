//BruteForce Approach

Key Idea
Store the last k elements in a temporary array.
Shift the remaining elements k positions to the right.
Place the stored elements at the beginning.
Use k = k % n to handle k > n.

Time: O(n)
Space: O(k)

class Solution {
    public void rotate(int[] nums, int k) {
        int n = nums.length;
        k = k % n;

        int[] temp = new int[k];

        // 1. Store last k elements
        for(int i = 0; i < k; i++) {
            temp[i] = nums[n - k + i];
        }

        // 2. Shift remaining elements to the right
        for(int i = n - k - 1; i >= 0; i--) {
            nums[i + k] = nums[i];
        }

        // 3. Put stored elements at the beginning
        for(int i = 0; i < k; i++) {
            nums[i] = temp[i];
        }
    }
}
