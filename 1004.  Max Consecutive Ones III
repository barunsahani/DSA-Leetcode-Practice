//BruteForce Approach    (T.C : O(n^2) , S.C : O(1) )


class Solution {
    public int longestOnes(int[] nums, int k) {

        int n = nums.length;
        int zeros;
        int len = 0, maxlen = 0;

        for(int i = 0; i < n; i++) {
            zeros = 0;
            for(int j = i; j < n; j++) {
                if(nums[j] == 0) zeros++;

                if(zeros <= k) {
                    len = j - i + 1;
                    maxlen = Math.max(maxlen ,len);

                } else {
                    break;
                }
            }
        }
        return maxlen;

    }
}




//Better Approach          (T.C : O(n+n) , S.C : O(1) )


class Solution {
    public int longestOnes(int[] nums, int k) {

        int n = nums.length;
        int zeros = 0;
        int len = 0, maxlen = 0;
        int l = 0, r = 0;

        while(r < n) {
            if(nums[r] == 0) zeros++;

            while(zeros > k) {
                if(nums[l] == 0) {
                zeros--;
                }
                l++;
            }

            if(zeros <= k) {
                len = r - l + 1;
                maxlen = Math.max(len ,maxlen);
            }
            r++;
        }

        
        return maxlen;

    }
}




