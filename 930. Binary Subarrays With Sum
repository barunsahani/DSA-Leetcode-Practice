//Better Approach Using HashMap and Prefix      (T.C : O(N) , S.C : O(N) )

class Solution {
    public int numSubarraysWithSum(int[] nums, int goal) {
        int k = goal;
        HashMap<Integer, Integer> mpp = new HashMap<>();

        int preSum = 0;
        int count = 0;

        // Base case: prefix sum = 0 occurs once
        mpp.put(0, 1);

        for (int i = 0; i < nums.length; i++) {
            preSum += nums[i];

            int remove = preSum - k;

            if (mpp.containsKey(remove)) {
                count += mpp.get(remove);
            }

            mpp.put(preSum, mpp.getOrDefault(preSum, 0) + 1);
        }

        return count;
    
    }
}





//Best (OPtimized Approach )    (T.C : O(N) , S.C : O(1) )


class Solution {

    public int numSubarraysWithSum(int[] nums, int goal) {
        return atMost(nums, goal) - atMost(nums, goal - 1);
    }


    private int atMost(int[] nums, int k) { 
        if(k < 0) return 0;

        int n = nums.length;
        int l = 0, r = 0;
        int sum = 0, count = 0;

        while(r < n) {
            sum += nums[r];

            while(sum > k) {
                sum = sum - nums[l];
                l++;
            }
            count = count + (r - l + 1);
            r++;
        }
        return count;
    }
        
    
    
}
