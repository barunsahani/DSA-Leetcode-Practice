import java.util.*;

class Solution {
    boolean graphColoring(int v, int[][] edges, int m) {

        // Create adjacency matrix
        boolean[][] graph = new boolean[v][v];

        // Fill graph using edges
        for (int[] edge : edges) {
            int u = edge[0];
            int w = edge[1];

            graph[u][w] = true;
            graph[w][u] = true;
        }

        int[] color = new int[v];

        // Start coloring from node 0
        return solve(0, color, m, v, graph);
    }

    // Check whether color 'col' can be assigned to node
    public static boolean isSafe(int node, int[] color, boolean[][] graph, int n, int col ) {
        for (int k = 0; k < n; k++) {

            // If k is connected to node
            // and has the same color
            if (graph[k][node] && color[k] == col) {
                return false;
            }
        }

        return true;
    }

    // Backtracking function
    public static boolean solve(int node, int[] color, int m, int n, boolean[][] graph ) {

        // All nodes are colored
        if (node == n) {
            return true;
        }

        // Try colors 1 to m
        for (int col = 1; col <= m; col++) {

            // Check if this color is safe
            if (isSafe(node, color, graph, n, col)) {

                // Assign color
                color[node] = col;

                // Color next node
                if (solve(node + 1, color, m, n, graph)) {
                    return true;
                }

                // Backtrack
                color[node] = 0;
            }
        }

        return false;
    }
}
