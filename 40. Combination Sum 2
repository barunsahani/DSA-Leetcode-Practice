[T.C :  O(2^n * k ) , S.C : O(k * x) ]



import java.util.*;

class Solution {

    public List<List<Integer>> combinationSum2(int[] candidates, int target) {

        List<List<Integer>> ans = new ArrayList<>();
        Arrays.sort(candidates);
        findCombinations(0, candidates, target, new ArrayList<>(), ans);
        return ans;
    }

    private void findCombinations(int index,int[] candidates,int target,List<Integer> ds,List<List<Integer>> ans) {

        // Target achieved
        if (target == 0) {
            ans.add(new ArrayList<>(ds));
            return;
        }

        for (int i = index; i < candidates.length; i++) {

            // 2. Skip duplicates at the same recursion level
            if (i > index && candidates[i] == candidates[i - 1]) {
                continue;
            }

            // 3. Since array is sorted, no later element can work
            if (candidates[i] > target) {
                break;
            }

            // Choose
            ds.add(candidates[i]);

            // i + 1 => each element can be used only once
            findCombinations( i + 1, candidates, target - candidates[i], ds, ans);

            // Backtrack
            ds.remove(ds.size() - 1);
        }
    }
}




//bruteforce  //TLE


import java.util.*;

class Solution {

    public List<List<Integer>> combinationSum2(int[] candidates, int target) {

        Set<List<Integer>> set = new HashSet<>();

        generate(0, candidates, target, new ArrayList<>(), set);

        return new ArrayList<>(set);
    }

    private void generate( int index, int[] arr, int target, List<Integer> current, Set<List<Integer>> set) {

        // Reached the end
        if (index == arr.length) {

            if (target == 0) {
                List<Integer> temp = new ArrayList<>(current);

                // Important: Set compares Lists based on their elements
                Collections.sort(temp);

                set.add(temp);
            }

            return;
        }

        // Don't take
        generate(index + 1, arr, target, current, set);

        // Take
        current.add(arr[index]);

        generate( index + 1, arr, target - arr[index], current, set );

        // Backtrack
        current.remove(current.size() - 1);
    }
}
