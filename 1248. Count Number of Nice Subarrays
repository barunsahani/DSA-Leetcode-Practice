//BruteForce OLD STYLE    (T.C : O(N^3) , S.C : O(1) )     "TIME LIMIT EXCEEDED"

class Solution {
    public int numberOfSubarrays(int[] nums, int k) {
        
        int n = nums.length;
        int  count = 0;

        for(int i = 0; i < n; i++) {
            for(int j = i; j < n; j++) {
            int sum = 0;
                
                for(int l=i; l <= j; l++) {

                sum += (nums[l] % 2);
                }
                if(sum == k) {
                    count++;
                }

                
            }
        }
        return count;
    }
}


