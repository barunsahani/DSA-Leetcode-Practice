//BruteForce Approach    (T.C : O(N^2) , S.C : O(256) 

class Solution {
    public String minWindow(String s, String t) {
        int n = s.length();
        int m = t.length();
        int min_len = Integer.MAX_VALUE;
        int start_index = -1;

        for(int i = 0; i < n; i++) {
            int[] hash = new int[256];
            int count = 0;

            for(int j = 0; j < m; j++) hash[t.charAt(j)]++;

            for(int j = i; j < n; j++) {
                if(hash[s.charAt(j)] > 0) count++;

                hash[s.charAt(j)]--;

                if(count == m) {
                    if(j - i + 1 < min_len) {
                        min_len = j - i + 1;
                        start_index = i;
                        break;
                    }
                }
            }
            
        }
        if (start_index == -1) return "";

        return s.substring(start_index, start_index + min_len);
    }
}






